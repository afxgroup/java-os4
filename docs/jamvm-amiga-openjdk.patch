+ * There is no unwinding back to main() from here -- we are many Java frames
+ * deep -- so this is realAmigaExit(), which reaps the child tasks and _Exit()s.
+ * Legitimate here precisely because it IS the main task.
+ */
+void amigaMainThreadExitIfRequested(void) {
+    if(!amiga_main_exit_requested)
+        return;
+
+    /* Once: realAmigaExit does not return, but do not race a second poll. */
+    amiga_main_exit_requested = FALSE;
+
+    DebugPrintF("[EXIT] main thread taking the process down (status=%d)\n",
+                amiga_main_exit_status);
+
+    if(amiga_awt_cleanup_fn != NULL) {
+        DebugPrintF("[EXIT] main thread: closing AWT windows\n");
+        amiga_awt_cleanup_fn();
+    }
+
+    realAmigaExit(amiga_main_exit_status);
+}
+
+static void amiga_exit(int status) {
+    int tries = 0;
+    int main_exit = isMainVMThread();
+    int target_threads = main_exit ? 1 : 2;
+
+    DebugPrintF("[EXIT] amiga_exit(%d): terminating VM threads\n", status);
+
+    /* Publish the request BEFORE waking anyone: exitWakeAllThreads() below
+       opens the dispatch-poll gate, and the main thread may reach its next poll
+       immediately.  If the flag were set later it would simply be picked up on
+       a subsequent poll, but there is no reason to leave that to chance. */
+    if(!main_exit) {
+        amiga_main_exit_status = status;
+        amiga_main_exit_requested = TRUE;
+        MBARRIER();
+    }
+
+    terminateVMThreads();
+
+    /* The Signal Handler thread parks on a semaphore, not on Object.wait, so
+       terminateVMThreads/exitWakeAllThreads below cannot reach it.  Release it
+       explicitly or the drain loop spins out its 300 tries and clib4's exit()
+       then waits forever for the pthread. */
+    classlibSignalThreadExit();
+
+    /* Wake every remaining Java thread (EDT, AWT pump, Disposer, ...) out of
+       Object.wait/sleep; they self-terminate at the next dispatch poll
+       (threadPollSuspend).  clib4 exit() waits for ALL pthread children, so
+       drain the count (bounded) before exiting or the process wedges with
+       "Parent suspended, waiting for child to exit". */
+    DebugPrintF("[EXIT] amiga_exit: wait target=%d current=%d main_exit=%d\n",
+                target_threads, getThreadsCount(), main_exit);
+    exitWakeAllThreads();
+    while(getThreadsCount() > target_threads && tries++ < 300) {
+        if(tries == 1 || (tries % 10) == 0) {
+            DebugPrintF("[EXIT] wait loop try=%d threads=%d target=%d\n",
+                        tries, getThreadsCount(), target_threads);
+        }
+        /* a woken thread can re-enter Object.wait before its next dispatch
+           poll -- re-interrupt periodically until everyone is gone */
+        if(tries % 50 == 0) {
+            DebugPrintF("[EXIT] wait loop: forcing wake-all + thread dump\n");
+            exitWakeAllThreads();
+            exitDumpRemainingThreads();
+        }
+        usleep(10000);
+    }
+
+    DebugPrintF("[EXIT] wait loop done tries=%d threads=%d target=%d\n",
+                tries, getThreadsCount(), target_threads);
+
+    DebugPrintF("[EXIT] amiga_exit: %s (threads left=%d)\n",
+                main_exit ? "calling exit()" : "delegating final exit to main thread",
+                getThreadsCount());
+    if(getThreadsCount() > target_threads)
+        exitDumpRemainingThreads();
+
+    if(!main_exit) {
+        DebugPrintF("[EXIT] amiga_exit: non-main thread exiting, main will take "
+                    "the process down at its next poll\n");
+        pthread_exit(NULL);
+    }
+
+    /* Close any Intuition windows before returning to main().  The atexit
+       handler registered by libamigaawt is bypassed if anything later calls
+       _Exit(), so invoke its cleanup directly if the library registered one. */
+    if(amiga_awt_cleanup_fn != NULL) {
+        DebugPrintF("[EXIT] amiga_exit: closing AWT windows\n");
+        amiga_awt_cleanup_fn();
+    }
+
+    /* Return to the caller (exitVM -> main).  The main thread will then return
+       from main() and let the C runtime perform a clean process exit.  Do NOT
+       call _Exit() or signal/kill child tasks from here: AmigaOS4 requires the
+       executable's main task to drive shutdown. */
+    DebugPrintF("[EXIT] amiga_exit: returning to main (status=%d)\n", status);
+}
