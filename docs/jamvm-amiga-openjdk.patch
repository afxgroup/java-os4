+ * the cooperative VM-thread shutdown has drained threads_count.  clib4's
+ * exit() waits for ALL child pthreads (which are real AmigaOS child
+ * processes); a stuck child (e.g. a wedged EDT) would deadlock the process
+ * forever.  Break-signal any surviving children, wait for them to go away,
+ * then _Exit(), which bypasses clib4's parent-waits-child logic entirely.
+ *
+ * Reconstructed for the clib4 build from the JAmiga-era scanprocess.c logic.
+ */
+
+#include <stdint.h>
+#include <unistd.h>
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/utility.h>
+
+#ifndef JA_TRACE
+#define JA_TRACE(fmt, ...) DebugPrintF(fmt, ##__VA_ARGS__)
+#endif
+
+/* ProcessScan hook: break-signal every surviving child process of the VM
+   (skipping filesystem handler processes and already-removed tasks). */
+static uint32 ASM find_java_child_kill(REG(a0, struct Hook *hook),
+                                       REG(a2, struct Process *parentproc),
+                                       REG(a1, struct Process *proc)) {
+    if(proc->pr_ParentID == parentproc->pr_ProcessID
+            && (proc->pr_Flags & (1 << PRB_HANDLERPROCESS)) != (1 << PRB_HANDLERPROCESS)
+            && proc->pr_Task.tc_State != TS_REMOVED) {
+        JA_TRACE("[EXIT] break-signalling child %ld (%s)\n",
+                 proc->pr_ProcessID, proc->pr_Task.tc_Node.ln_Name);
+        Signal((struct Task *)proc, SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_F);
+        (*(uint32 *)hook->h_Data)++;
+    }
+    return 0;   /* continue scanning */
+}
+
+void realAmigaExit(int error) {
+    struct Process *me = (struct Process *)FindTask(NULL);
+    struct Hook H;
+    uint32 proc_count;
+    int tries = 0;
+
+    JA_TRACE("[EXIT] realAmigaExit(%d)\n", error);
+
+    NotifyProcListChange(me, SIGBREAKB_CTRL_F, 0);
+
+    H.h_Entry = (APTR)&find_java_child_kill;
+    H.h_Data = &proc_count;
+
+    do {
+        proc_count = 0;
+        ProcessScan(&H, (CONST APTR)me, 0);
+
+        JA_TRACE("[EXIT] waiting for %ld child processes\n", proc_count);
+        if(proc_count > 0)
+            Wait(SIGBREAKF_CTRL_F);
+    } while(proc_count > 0 && tries++ < 100);
+
+    NotifyProcListChange(NULL, NPLC_END, 0);
+
+    /* Hard exit: no atexit, no clib4 child-wait -- the process is gone now. */
+    _Exit(error);
+}
