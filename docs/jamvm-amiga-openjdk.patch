+/* JVM_CopySwapMemory */
+
+void JVM_CopySwapMemory(JNIEnv *env, jobject srcObj, jlong srcOffset,
+                        jobject dstObj, jlong dstOffset, jlong size,
+                        jlong elemSize) {
+    char *src = (char *)srcObj + srcOffset;
+    char *dst = (char *)dstObj + dstOffset;
+    jlong i, j;
+
+    TRACE("JVM_CopySwapMemory(src=%p, dst=%p, size=%lld, elem=%lld)",
+          src, dst, size, elemSize);
+
+    if(size <= 0 || elemSize <= 0 || src == dst)
+        return;
+
+    /* Copy element-by-element, reversing byte order within each element */
+    for(i = 0; i + elemSize <= size; i += elemSize)
+        for(j = 0; j < elemSize; j++)
+            dst[i + j] = src[i + elemSize - 1 - j];
+}
