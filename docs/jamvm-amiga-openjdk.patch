diff --git a/src/os/amiga/real_amiga_exit.c b/src/os/amiga/real_amiga_exit.c
new file mode 100644
index 0000000..728d9bc
--- /dev/null
+++ b/src/os/amiga/real_amiga_exit.c
@@ -0,0 +1,114 @@
+/*
+ * AmigaOS4 final process teardown for the clib4/OpenJDK build.
+ *
+ * The upstream JAmiga scanprocess.c contains a realAmigaExit() that depends on
+ * the old JAmiga pthread/memory/baseline_glue shims.  In the clib4 build those
+ * shims are intentionally replaced by clib4's own pthread/scandir/signal/mmap,
+ * so that implementation cannot be linked.  This file provides a self-contained
+ * realAmigaExit() that uses only Exec/DOS APIs to terminate remaining child
+ * tasks before calling _Exit(), avoiding the clib4 "parent waits for children"
+ * wedge that hangs AWT/Swing shutdown.
+ */
+
+#ifdef __amigaos4__
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <signal.h>
+
+#include <proto/exec.h>
+#include <proto/dos.h>
+#include <proto/utility.h>
+
+#ifndef JA_TRACE
+#define JA_TRACE(fmt, ...) DebugPrintF(fmt, ##__VA_ARGS__)
+#endif
+
+#define BYTETOBINARYPATTERN "%d%d%d%d %d%d%d%d %d%d%d%d %d%d%d%d"
+#define BYTETOBINARY(byte)  \
+  (byte & 0x8000 ? 1 : 0), \
+  (byte & 0x4000 ? 1 : 0), \
+  (byte & 0x2000 ? 1 : 0), \
+  (byte & 0x1000 ? 1 : 0), \
+  (byte & 0x0800 ? 1 : 0), \
+  (byte & 0x0400 ? 1 : 0), \
+  (byte & 0x0200 ? 1 : 0), \
+  (byte & 0x0100 ? 1 : 0), \
+  (byte & 0x0080 ? 1 : 0), \
+  (byte & 0x0040 ? 1 : 0), \
+  (byte & 0x0020 ? 1 : 0), \
+  (byte & 0x0010 ? 1 : 0), \
+  (byte & 0x0008 ? 1 : 0), \
+  (byte & 0x0004 ? 1 : 0), \
+  (byte & 0x0002 ? 1 : 0), \
+  (byte & 0x0001 ? 1 : 0)
+
+/**
+ * ProcessScan() hook: kill (or signal) any child process of the caller.
+ * We do not try to distinguish Java threads from other children here;
+ * by the time realAmigaExit() runs the VM has already asked every thread
+ * to exit cooperatively, so anything still alive is a shutdown straggler.
+ */
+STATIC uint32 ASM find_child_kill(REG(a0, struct Hook *hook),
+                                  REG(a2, struct Process *parentproc),
+                                  REG(a1, struct Process *proc))
+{
+    uint32 sigSet = 0;
+
+    if(proc->pr_ParentID == parentproc->pr_ProcessID) {
+        JA_TRACE("child %ld (%20s) state:"BYTETOBINARYPATTERN"\n",
+                 proc->pr_ProcessID,
+                 ((struct Task*)proc)->tc_Node.ln_Name,
+                 BYTETOBINARY(((struct Task*)proc)->tc_State));
+
+        if(proc->pr_Task.tc_State == TS_SUSPENDED) {
+            JA_TRACE("Removing suspended child %ld\n", proc->pr_ProcessID);
+            RemTask((struct Task *)proc);
+            (*(uint32*)hook->h_Data)++;
+        } else if((proc->pr_Task.tc_State != TS_READY) &&
+                  (proc->pr_Task.tc_State != TS_REMOVED)) {
+            sigSet = (1 << SIGKILL);
+            JA_TRACE("Signalling child %ld with SIGKILL\n", proc->pr_ProcessID);
+            Signal((struct Task *)proc, sigSet);
+            (*(uint32*)hook->h_Data)++;
+        } else {
+            JA_TRACE("Not signalling ready child %ld\n", proc->pr_ProcessID);
+        }
+    }
+    return 0; /* continue scanning */
+}
+
+/**
+ * Hard process exit: signal/kill remaining child tasks, then _Exit().
+ */
+void realAmigaExit(int error)
+{
+    struct Task *me = FindTask(NULL);
+    struct Hook H;
+    uint32 proc_count;
+
+    JA_TRACE("realAmigaExit(%d)\n", error);
+
+    /* Ask DOS to notify us when the process list changes. */
+    NotifyProcListChange((struct Process *)me, SIGBREAKB_CTRL_F, 0);
+
+    H.h_Entry = (APTR)&find_child_kill;
+    H.h_Data = &proc_count;
+
+    do {
+        proc_count = 0;
+        ProcessScan(&H, (APTR)me, 0);
+
+        if(proc_count > 0) {
+            JA_TRACE("Waiting for %ld children to die\n", proc_count);
+            Wait(SIGBREAKF_CTRL_F);
+        }
+    } while(proc_count > 0);
+
+    NotifyProcListChange(NULL, NPLC_END, 0);
+
+    JA_TRACE("realAmigaExit: calling _Exit(%d)\n", error);
+    _Exit(error);
+}
+
+#endif /* __amigaos4__ */
