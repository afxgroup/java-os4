+
+int
+spawnvpe(
+    const char *file,
+    const char **argv,
+    char **deltaenv,
+    const char *_cwd,
+    int fhin,
+    int fhout,
+    int fherr
+) {
+    return spawnvpe_common(file, argv, deltaenv, _cwd, fhin, fhout, fherr, FALSE);
+}
+
+/*
+ * As spawnvpe(), but the child is independent of this process: it is not a DOS
+ * child, it does not signal this Task when it exits, and it is not given a
+ * pointer to it.  Returns a pid, but that pid cannot be waited for.
+ *
+ * For programs meant to outlive their parent -- launchers, auto-updaters,
+ * anything the caller starts and then exits.
+ */
+int
+spawnvpe_detached(
+    const char *file,
+    const char **argv,
+    char **deltaenv,
+    const char *_cwd,
+    int fhin,
+    int fhout,
+    int fherr
+) {
+    return spawnvpe_common(file, argv, deltaenv, _cwd, fhin, fhout, fherr, TRUE);
+}
