+/*
+ * detached: create a process that does NOT depend on this one.
+ *
+ * The normal spawn ties the child to its parent three ways: NP_Child makes it a
+ * DOS child, NP_NotifyOnDeathSigTask has it Signal() the parent's Task when it
+ * exits, and spawnData.parentTask hands the child a pointer to that Task.  All
+ * three are correct while the parent lives, and all three are dangling the
+ * moment it does not.
+ *
+ * A launcher or an auto-updater is exactly the case that breaks: the parent
+ * starts a program that is MEANT to outlive it, then exits.  The child is left
+ * signalling a freed Task and DOS is left holding the parent's process
+ * structure ("Parent #N deletion resuming, all children have now gone"), and
+ * the child crashes some time later, far from the cause.
+ *
+ * A detached child cannot be waited for -- waitpid() has nothing to wait on --
+ * which is the whole trade: independence in exchange for the exit status.
+ */
+static int spawnvpe_common(
     const char *file,
     const char **argv,
     char **deltaenv,
     const char *_cwd,
     int fhin,
     int fhout,
-    int fherr
+    int fherr,
+    BOOL detached
 ) {
     int ret = -1;
     struct name_translation_info nti_name;
@@ -217,7 +235,17 @@ spawnvpe(
 
     D(("(*)Calling SystemTags.\n"));
 
-    fd_inherit = build_fd_inherit_spec(__clib4, fhin, fhout, fherr);
+    /*
+     * A detached child inherits NOTHING of ours.
+     *
+     * build_fd_inherit_spec hands over every descriptor without FD_CLOEXEC,
+     * which is right for an ordinary child and wrong for one that must outlive
+     * us: each of those is a handle owned by a process that is about to go, and
+     * the child faults on the first use afterwards.  Its stdio comes from the
+     * NIL: handles opened above instead.
+     */
+    fd_inherit = detached ? NULL
+                          : build_fd_inherit_spec(__clib4, fhin, fhout, fherr);
 
     data = AllocVecTags(sizeof(*data), AVT_Type, MEMF_SHARED, TAG_DONE);
     if (data == NULL) {
@@ -235,22 +263,34 @@ spawnvpe(
     }
 
     data->groupId = getgid();
-    data->parentTask = FindTask(NULL);
+    /* A detached child must not hold a pointer to a Task that may be gone
+       before it looks at it. */
+    data->parentTask = detached ? NULL : FindTask(NULL);
     data->parentUuid[0] = '\0';
     data->fdInherit = fd_inherit;
     data->freeData = TRUE;
-    if (__CLIB4->uuid)
+    /* Left empty when detached: the uuid is what insertSpawnedChildren files the
+       child under in the PARENT's children table, and a detached child does not
+       belong in a table owned by a process that will not be there. */
+    if (!detached && __CLIB4->uuid)
         strncpy(data->parentUuid, __CLIB4->uuid, UUID4_LEN);
 
     ret = SystemTags(full_command,
-                    NP_NotifyOnDeathSigTask, me,
+                    /* Binds the child's lifetime to ours; dropped when
+                       detached so it outlives us cleanly.
+                       TAG_IGNORE, not TAG_SKIP: TAG_SKIP means "skip this and
+                       the next ti_Data items", and ti_Data here is `me` -- a
+                       Task pointer, i.e. a count of about a billion, which
+                       walks SystemTags straight off the end of the tag array.
+                       TAG_IGNORE ignores exactly this one item and its data. */
+                    detached ? TAG_IGNORE : NP_NotifyOnDeathSigTask, me,
                     SYS_Input,          iofh[0],
                     SYS_Output,         iofh[1],
                     SYS_Error,          iofh[2],
                     NP_CloseError,      TRUE,
                     SYS_UserShell,      TRUE,
                     SYS_Asynch,         TRUE,
-                    NP_Child,           TRUE,
+                    NP_Child,           detached ? FALSE : TRUE,
                     NP_StackSize,       2024 * 1024,
