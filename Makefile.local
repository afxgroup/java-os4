# Java-OS4 -- host-local build orchestration (no Docker).
#
# Requires the AmigaOS cross toolchain on PATH and a host JDK 8 with javah.
# clib4 is taken from the installed SDK by default; the in-repo clib4/ tree is
# used only if CLIB4_BUILD_ROOT points at an already-built checkout.
#
#   make -f Makefile.local vendor        fetch the vendored JamVM + IcedTea 8 upstream sources (once)
#   make -f Makefile.local clib4         no-op: use the installed SDK clib4
#   make -f Makefile.local vm            build the VM (libjvm.so + jamvm-openjdk launcher)
#   make -f Makefile.local natives       build the OpenJDK 8 + AWT native libraries
#   make -f Makefile.local toolkit       build the sun.awt.amiga toolkit + test zips
#   make -f Makefile.local tests         build the VM test suite + bundled examples
#   make -f Makefile.local test-charset  host-compile + run the Amiga charset-name unit test
#   make -f Makefile.local awttest       compile examples/AWT1.java and package awttest.jar correctly
#   make -f Makefile.local boot-jdk      download Temurin JDK 8 locally into build/boot-jdk8
#   make -f Makefile.local build         vm + natives + toolkit + tests
#   make -f Makefile.local dist          assemble the install tree + the .lha release  (alias: lha)
#   make -f Makefile.local release       build everything, then dist
#   make -f Makefile.local clean-dist    remove build/release and the .lha

include config.mk

VERSION := $(shell cat VERSION)
LHA     := build/JavaOS4-$(VERSION).lha

ifeq ($(origin SDK_BASE), file)
SDK_BASE := $(shell for d in /usr/ppc-amigaos/SDK /opt/ppc-amigaos/ppc-amigaos/SDK; do if [ -d "$$d" ]; then echo "$$d"; break; fi; done)
endif
ifeq ($(origin SDK_CLIB4), file)
SDK_CLIB4 := $(SDK_BASE)/clib4
endif
OPENJDK8_SRC ?= $(if $(wildcard $(CURDIR)/vendor/openjdk8/jdk/src),$(CURDIR)/vendor/openjdk8/jdk,$(firstword $(sort $(wildcard $(CURDIR)/build/openjdk8/jdk-*))))
BOOT_JDK_URL ?= https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jdk/hotspot/normal/eclipse
JAVAH_BIN := $(shell command -v javah 2>/dev/null)
JAVAH_HOME := $(patsubst %/bin/javah,%,$(JAVAH_BIN))
BOOT_JDK ?= $(if $(wildcard $(CURDIR)/build/boot-jdk8/bin/javah),$(CURDIR)/build/boot-jdk8,$(if $(JAVAH_HOME),$(JAVAH_HOME),$(JAVA_HOME)))

SCRIPT_ENV = PROJECT_ROOT="$(CURDIR)" BUILD_ROOT="$(CURDIR)/build" BOOT_JDK="$(BOOT_JDK)" \
	SDK_BASE="$(SDK_BASE)" SDK_CLIB4="$(SDK_CLIB4)" OPENJDK8_SRC="$(OPENJDK8_SRC)"

.PHONY: vendor clib4 check-local boot-jdk vm natives toolkit tests test-charset awttest build dist lha release clean-dist help

help:
	@sed -n 's/^#   //p' Makefile.local

check-local: boot-jdk
	@command -v ppc-amigaos-gcc >/dev/null || { echo "Missing ppc-amigaos-gcc in PATH"; exit 1; }
	@[ -n "$(SDK_BASE)" ] && [ -d "$(SDK_CLIB4)" ] || { echo "Missing AmigaOS SDK clib4 (set SDK_BASE or SDK_CLIB4)"; exit 1; }
	@[ -n "$(BOOT_JDK)" ] && [ -x "$(BOOT_JDK)/bin/javac" ] || { echo "Missing BOOT_JDK (set it to a JDK 8 home, or run: make -f Makefile.local boot-jdk)"; exit 1; }
	@[ -x "$(BOOT_JDK)/bin/javah" ] || { echo "BOOT_JDK must be a JDK 8 with javah (try: make -f Makefile.local boot-jdk)"; exit 1; }
	@[ -n "$(OPENJDK8_SRC)" ] || { echo "Missing vendor/openjdk8/jdk source tree or build/openjdk8/jdk-* sources (or set OPENJDK8_SRC)"; exit 1; }

boot-jdk:
	@if [ -x "$(BOOT_JDK)/bin/javah" ]; then \
		echo "Using existing BOOT_JDK: $(BOOT_JDK)"; \
	else \
		rm -rf build/boot-jdk8 build/boot-jdk8.tar.gz; \
		mkdir -p build/boot-jdk8; \
		curl -fsSL -o build/boot-jdk8.tar.gz "$(BOOT_JDK_URL)"; \
		tar -xzf build/boot-jdk8.tar.gz -C build/boot-jdk8 --strip-components=1; \
		[ -x "$(CURDIR)/build/boot-jdk8/bin/javah" ] || { echo "Downloaded Boot JDK does not provide javah"; exit 1; }; \
		echo "Boot JDK ready in $(CURDIR)/build/boot-jdk8"; \
	fi

vendor:
	sh tools/fetch-vendor.sh

clib4:
	@echo "Using installed clib4 from $(SDK_CLIB4)"

vm: check-local
	$(SCRIPT_ENV) sh tools/build-jamvm-openjdk.sh

natives: check-local
	$(SCRIPT_ENV) sh tools/build-openjdk-natives.sh
	$(SCRIPT_ENV) sh tools/build-awt-natives.sh
	$(SCRIPT_ENV) sh tools/build-amigaawt.sh

toolkit: check-local
	$(SCRIPT_ENV) sh tools/build-amigatoolkit.sh

tests: check-local
	$(SCRIPT_ENV) sh tools/build-tests.sh

test-charset:
	mkdir -p build && cc tools/test-amiga-charset.c -o build/test-amiga-charset && build/test-amiga-charset

awttest:
	mkdir -p build/examples examples
	"$(BOOT_JDK)/bin/javac" -source 8 -target 8 -d build examples/AWT1.java
	cd build && "$(BOOT_JDK)/bin/jar" cfe examples/awttest.jar AWT1 AWT1*.class

build: vm natives toolkit tests

dist: check-local
	$(SCRIPT_ENV) sh tools/package.sh
	@echo "Release: $(LHA)"

lha: dist

release: build dist

clean-dist:
	rm -rf build/release $(LHA)